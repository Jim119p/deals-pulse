---
interface Props {
  deal: {
    id: string;
    title: string;
    slug: string;
    deal_price: number;
    original_price: number;
    discount_percent: number;
    merchant: string;
    category: string;
    image_url: string;
    affiliate_url: string;
    published_at: string;
    description: string;
  };
}

const { deal } = Astro.props;
const savings = (deal.original_price - deal.deal_price).toFixed(2);
---

<article class="group bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm hover:shadow-xl hover:border-emerald-500/40 transition-all duration-300 flex flex-col justify-between">
  <div>
    <!-- Top Image Container -->
    <div class="relative w-full h-48 bg-slate-100 overflow-hidden flex items-center justify-center p-4">
      <img 
        src={deal.image_url} 
        alt={deal.title}
        loading="lazy"
        class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
      />
      
      <!-- Discount Badge -->
      {deal.discount_percent > 0 && (
        <span class="absolute top-3 left-3 bg-rose-600 text-white text-xs font-black px-2.5 py-1 rounded-lg shadow-md uppercase tracking-wide">
          {deal.discount_percent}% OFF
        </span>
      )}

      <!-- Merchant Badge -->
      <span class="absolute top-3 right-3 bg-white/95 backdrop-blur text-slate-800 text-[11px] font-bold px-2 py-0.5 rounded-md border border-slate-200 shadow-sm">
        {deal.merchant}
      </span>
    </div>

    <!-- Content Details -->
    <div class="p-5">
      <div class="flex items-center space-x-2 text-xs font-semibold text-emerald-700 mb-2">
        <span class="bg-emerald-50 px-2 py-0.5 rounded">{deal.category}</span>
        <span class="text-slate-300">•</span>
        <span class="text-slate-400">Verified Drop</span>
      </div>

      <h3 class="font-bold text-slate-900 text-base leading-snug line-clamp-2 group-hover:text-emerald-600 transition">
        <a href={`/deals/${deal.slug}`}>
          {deal.title}
        </a>
      </h3>

      <!-- Pricing Bar -->
      <div class="mt-4 flex items-baseline space-x-2">
        <span class="text-2xl font-black text-slate-900 tracking-tight">
          ${deal.deal_price.toFixed(2)}
        </span>
        {deal.original_price > deal.deal_price && (
          <span class="text-sm font-semibold text-slate-400 line-through">
            ${deal.original_price.toFixed(2)}
          </span>
        )}
        {Number(savings) > 0 && (
          <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded">
            Save ${savings}
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- Bottom CTA Row -->
  <div class="p-5 pt-0 mt-2 flex items-center space-x-2">
    <a 
      href={`/deals/${deal.slug}`}
      class="flex-1 text-center py-2 px-3 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-100 transition"
    >
      Review Deal
    </a>
    <a 
      href={deal.affiliate_url} 
      target="_blank" 
      rel="noopener noreferrer sponsored"
      class="flex-1 text-center py-2 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-md shadow-emerald-600/20 transition flex items-center justify-center space-x-1"
    >
      <span>Get Deal</span>
      <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</article>
